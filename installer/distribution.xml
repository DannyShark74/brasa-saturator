<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Brasa @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="done.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3 (FL Studio, Cubase, Ableton)" description="~/Library/Audio/Plug-Ins/VST3/Brasa.vst3">
        <pkg-ref id="com.dannyshark.brasa.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (Logic, GarageBand, FL Studio AU)" description="~/Library/Audio/Plug-Ins/Components/Brasa.component">
        <pkg-ref id="com.dannyshark.brasa.au"/>
    </choice>
    <pkg-ref id="com.dannyshark.brasa.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.dannyshark.brasa.au" version="@VERSION@">au.pkg</pkg-ref>
</installer-gui-script>
